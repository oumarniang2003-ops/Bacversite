DATABASE_URL=
JWT_SECRET=

# Clé API Anthropic, utilisée par le job de mise à jour automatique
# (recherche web + extraction) — console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# Secret partagé avec Vercel Cron pour protéger /api/cron/sync-content
# Vercel envoie automatiquement "Authorization: Bearer <CRON_SECRET>"
# aux routes cron définies dans vercel.json — utiliser une valeur aléatoire longue
CRON_SECRET=

# Clé API Resend, utilisée pour l'email de réinitialisation de mot de
# passe étudiant — resend.com > API Keys
RESEND_API_KEY=

# Adresse d'expédition des emails transactionnels. Fonctionne tel quel
# avec "onboarding@resend.dev" (adresse de test Resend, sans domaine à
# vérifier) ; pour la prod, vérifier son propre domaine sur Resend et
# utiliser une adresse dessus, ex: "Bacversité <contact@bacversite.sn>"
EMAIL_FROM=
